{
  "name": "Python 3",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "Dashboard.py"
      ]
    },
    "vscode": {
      "settings": {
        "python.formatting.provider": "none",
        "python.linting.enabled": false
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "pip install --upgrade pip && [ -f packages.txt ] && sudo apt-get update && sudo apt-get install -y $(cat packages.txt) && rm -rf /var/lib/apt/lists/*; [ -f requirements.txt ] && pip install --user -r requirements.txt; pip install --user streamlit",
  "postCreateCommand": "echo 'Environment setup complete.'",
  "postAttachCommand": {
    "server": "streamlit run Dashboard.py --server.port 8501 --server.enableCORS false --server.enableXsrfProtection false"
  },
  "portsAttributes": {
    "8501": {
      "label": "Streamlit App",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8501
  ]
}